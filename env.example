# ---- Free option (default): Google Gemini via Google AI Studio ----
# Get a free key at https://aistudio.google.com/apikey
PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
# Optional. If this model is unavailable for your key, try gemini-3-flash-preview or gemini-3.5-flash
# GEMINI_MODEL=gemini-3.8-flash

# ---- Paid option: Anthropic (set PROVIDER=anthropic) ----
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_WORKSPACE_ID=wrkspc_...   # only if your key is not scoped to a workspace
# MODEL=claude-sonnet-5-5

PORT=3000

# Network troubleshooting (only if you see "Cannot reach ...")
# HTTPS_PROXY=http://user:pass@proxy.example.com:8080
# FORCE_IPV4=1
